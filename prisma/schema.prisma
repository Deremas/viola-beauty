generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
}

enum BookingSource {
  ONLINE_CLIENT
  ADMIN
  RECEPTIONIST
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_UPLOADED
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum PaymentStatus {
  NOT_PAID
  PROOF_UPLOADED
  ADVANCE_CONFIRMED
  FULLY_PAID
  PAYMENT_REJECTED
}

enum NotificationChannel {
  TELEGRAM
  SMS
  EMAIL
  WHATSAPP
}

enum StaffTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum StaffTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PermissionKey {
  VIEW_DASHBOARD
  VIEW_CALENDAR
  MANAGE_CALENDAR
  VIEW_BOOKINGS
  CREATE_BOOKINGS
  MANAGE_BOOKINGS
  CONFIRM_PAYMENTS
  VIEW_CLIENTS
  MANAGE_CLIENTS
  VIEW_PAYMENTS
  MANAGE_TASKS
  MANAGE_SERVICES
  MANAGE_BANK_ACCOUNTS
  MANAGE_AVAILABILITY
  MANAGE_STAFF
  MANAGE_ROLES
  MANAGE_NOTIFICATIONS
  VIEW_REPORTS
  VIEW_COURSES
  MANAGE_COURSES
  PUBLISH_COURSES
  VIEW_STUDENTS
  MANAGE_STUDENTS
  VIEW_STUDENT_SENSITIVE
  VIEW_REGISTRATIONS
  CREATE_REGISTRATIONS
  UPDATE_REGISTRATIONS
  APPROVE_REGISTRATIONS
  REJECT_REGISTRATIONS
  CONFIRM_REGISTRATIONS
  CANCEL_REGISTRATIONS
  WITHDRAW_REGISTRATIONS
  ASSIGN_INTAKE
  CHANGE_START_DATE
  MARK_CLASS_STARTED
  MARK_CLASS_FINISHED
  BULK_UPDATE_REGISTRATIONS
  EXPORT_REGISTRATIONS
  VIEW_COURSE_PAYMENTS
  RECORD_COURSE_PAYMENTS
  UPDATE_UNVERIFIED_PAYMENTS
  VERIFY_COURSE_PAYMENTS
  REJECT_COURSE_PAYMENTS
  REFUND_COURSE_PAYMENTS
  EXPORT_COURSE_PAYMENTS
  MANAGE_WEBSITE
  PUBLISH_WEBSITE
  VIEW_AUDIT_LOGS
}

enum TelegramNotificationEvent {
  PAYMENT_PROOF_UPLOADED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  BOOKING_RESCHEDULED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  BOOKING_NO_SHOW
}

enum BookingSubmissionStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  name         String
  phone        String?
  email        String?   @unique
  username     String    @unique
  passwordHash String
  role         UserRole
  staffRoleId  String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBookings             Booking[]            @relation("BookedBy")
  confirmedBookings           Booking[]            @relation("ConfirmedBy")
  cancelledBookings           Booking[]            @relation("CancelledBy")
  verifiedPayments            Payment[]            @relation("PaymentVerifiedBy")
  forfeitedPayments           Payment[]            @relation("PaymentAdvanceForfeitedBy")
  uploadedPrecautionDocuments PrecautionDocument[] @relation("PrecautionDocumentUploadedBy")
  bookingLogs                 BookingStatusLog[]
  assignedTasks               StaffTask[]          @relation("TaskAssignedTo")
  createdTasks                StaffTask[]          @relation("TaskCreatedBy")
  auditLogs                   AuditLog[]
  registrationEvents          RegistrationEvent[]
  recordedCoursePayments      CoursePayment[]      @relation("CoursePaymentRecordedBy")
  verifiedCoursePayments      CoursePayment[]      @relation("CoursePaymentVerifiedBy")
  createdRegistrations        CourseRegistration[] @relation("RegistrationCreatedBy")
  updatedRegistrations        CourseRegistration[] @relation("RegistrationUpdatedBy")
  staffRole                   StaffRole?           @relation(fields: [staffRoleId], references: [id])

  @@index([staffRoleId])
  @@index([deletedAt])
}

model StaffRole {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  isSystem    Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@index([deletedAt])
}

model RolePermission {
  id          String        @id @default(uuid())
  staffRoleId String
  permission  PermissionKey
  staffRole   StaffRole     @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)

  @@unique([staffRoleId, permission])
  @@index([permission])
}

model Client {
  id             String    @id @default(uuid())
  fullName       String
  phone          String
  alternatePhone String?
  email          String?
  address        String?
  birthDate      DateTime?
  source         String?
  preferences    String?
  allergies      String?
  note           String?
  internalNote   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bookings Booking[]
  tasks    StaffTask[]

  @@index([phone])
  @@index([isActive])
}

model Service {
  id                         String    @id @default(uuid())
  name                       String
  category                   String?
  description                String?
  price                      Decimal   @db.Decimal(12, 2)
  advanceAmount              Decimal   @db.Decimal(12, 2)
  durationMinutes            Int
  bufferMinutes              Int       @default(0)
  bookingWarningTitle        String?
  bookingWarningIntro        String?
  bookingWarningInstructions String?
  bookingWarningContact      String?
  bookingWarningActive       Boolean   @default(false)
  isActive                   Boolean   @default(true)
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  bookings Booking[]
  image    ServiceImage?
  content  ServiceContent?

  @@index([deletedAt])
}

model ServiceImage {
  id          String   @id @default(uuid())
  serviceId   String   @unique
  fileName    String
  contentType String
  fileSize    Int
  fileData    Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model BookingSetting {
  id                  String   @id @default("primary")
  slotIntervalMinutes Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WorkingHour {
  id          String   @id @default(uuid())
  dayOfWeek   Int
  openingTime String
  closingTime String
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dayOfWeek])
}

model BreakTime {
  id        String   @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DayOff {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  startTime String?
  endTime   String?
  isFullDay Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model BankAccount {
  id            String    @id @default(uuid())
  bankName      String
  accountName   String
  accountNumber String
  instructions  String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]

  @@index([deletedAt])
}

model Booking {
  id                        String        @id @default(uuid())
  bookingCode               String        @unique
  clientId                  String
  serviceId                 String
  startDateTime             DateTime
  endDateTime               DateTime
  status                    BookingStatus @default(PENDING_PAYMENT)
  source                    BookingSource
  bookedByUserId            String?
  confirmedByUserId         String?
  cancelledByUserId         String?
  note                      String?
  expiresAt                 DateTime?
  precautionsAcknowledgedAt DateTime?
  precautionNoticeSnapshot  String?
  precautionDocumentId      String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  client             Client              @relation(fields: [clientId], references: [id])
  service            Service             @relation(fields: [serviceId], references: [id])
  bookedBy           User?               @relation("BookedBy", fields: [bookedByUserId], references: [id])
  confirmedBy        User?               @relation("ConfirmedBy", fields: [confirmedByUserId], references: [id])
  cancelledBy        User?               @relation("CancelledBy", fields: [cancelledByUserId], references: [id])
  precautionDocument PrecautionDocument? @relation(fields: [precautionDocumentId], references: [id])

  payment          Payment?
  statusLogs       BookingStatusLog[]
  notificationLogs NotificationLog[]
  tasks            StaffTask[]
  submission       BookingSubmission?

  @@index([startDateTime])
  @@index([endDateTime])
  @@index([status])
  @@index([source])
  @@index([bookedByUserId])
  @@index([precautionDocumentId])
}

model BookingSubmission {
  id                 String                  @id @default(uuid())
  tokenHash          String                  @unique
  phoneHash          String
  requestFingerprint String
  status             BookingSubmissionStatus @default(PROCESSING)
  bookingId          String?                 @unique
  attemptCount       Int                     @default(1)
  lastErrorCode      String?
  lastAttemptedAt    DateTime                @default(now())
  completedAt        DateTime?
  expiresAt          DateTime
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([phoneHash])
  @@index([status, expiresAt])
}

model SecuritySetting {
  id                   String   @id @default("primary")
  sessionDurationDays  Int      @default(1)
  loginMax             Int      @default(5)
  loginWindowSeconds   Int      @default(900)
  bookingIpMax         Int      @default(5)
  bookingPhoneMax      Int      @default(3)
  bookingWindowSeconds Int      @default(900)
  statusMax            Int      @default(10)
  statusWindowSeconds  Int      @default(600)
  slotsMax             Int      @default(120)
  slotsWindowSeconds   Int      @default(300)
  uploadMax            Int      @default(5)
  uploadWindowSeconds  Int      @default(900)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RateLimitBucket {
  id          String   @id @default(uuid())
  action      String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([action, keyHash, windowStart])
  @@index([expiresAt])
}

model PrecautionDocument {
  id               String    @id @default(uuid())
  title            String
  fileName         String
  contentType      String
  fileSize         Int
  fileData         Bytes
  isActive         Boolean   @default(false)
  uploadedByUserId String?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())

  uploadedBy User?     @relation("PrecautionDocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  bookings   Booking[]

  @@index([isActive])
  @@index([createdAt])
  @@index([uploadedByUserId])
}

model Payment {
  id                       String        @id @default(uuid())
  bookingId                String        @unique
  requiredAdvanceAmount    Decimal       @db.Decimal(12, 2)
  paidAmount               Decimal?      @db.Decimal(12, 2)
  paymentStatus            PaymentStatus @default(NOT_PAID)
  paymentMethod            String?
  bankAccountId            String?
  screenshotPath           String?
  verifiedByUserId         String?
  verifiedAt               DateTime?
  rejectionReason          String?
  advanceForfeitedAmount   Decimal?      @db.Decimal(12, 2)
  advanceForfeitedAt       DateTime?
  advanceForfeitedByUserId String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  booking            Booking      @relation(fields: [bookingId], references: [id])
  bankAccount        BankAccount? @relation(fields: [bankAccountId], references: [id])
  verifiedBy         User?        @relation("PaymentVerifiedBy", fields: [verifiedByUserId], references: [id])
  advanceForfeitedBy User?        @relation("PaymentAdvanceForfeitedBy", fields: [advanceForfeitedByUserId], references: [id])

  @@index([advanceForfeitedByUserId])
}

model BookingStatusLog {
  id              String         @id @default(uuid())
  bookingId       String
  oldStatus       BookingStatus?
  newStatus       BookingStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime       @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id])
  changedBy User?   @relation(fields: [changedByUserId], references: [id])
}

model NotificationLog {
  id           String              @id @default(uuid())
  bookingId    String?
  channel      NotificationChannel
  recipient    String
  message      String
  status       String
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])
}

model TelegramBotSetting {
  id                String   @id @default("primary")
  botTokenEncrypted String
  botUsername       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TelegramRecipient {
  id            String                 @id @default(uuid())
  name          String
  chatId        String                 @unique
  personalId    String?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  subscriptions TelegramSubscription[]

  @@index([isActive])
}

model TelegramSubscription {
  id          String                    @id @default(uuid())
  recipientId String
  event       TelegramNotificationEvent
  recipient   TelegramRecipient         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, event])
  @@index([event])
}

model SmsSetting {
  id                       String   @id @default("primary")
  apiTokenEncrypted        String
  identifierId             String
  senderName               String
  isActive                 Boolean  @default(true)
  notifyPaymentConfirmed   Boolean  @default(true)
  notifyPaymentRejected    Boolean  @default(true)
  notifyBookingRescheduled Boolean  @default(true)
  notifyBookingCancelled   Boolean  @default(true)
  notifyBookingCompleted   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model StaffTask {
  id               String            @id @default(uuid())
  title            String
  description      String?
  status           StaffTaskStatus   @default(TODO)
  priority         StaffTaskPriority @default(NORMAL)
  assignedToUserId String?
  createdByUserId  String?
  relatedClientId  String?
  relatedBookingId String?
  dueAt            DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  assignedTo     User?    @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy      User?    @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  relatedClient  Client?  @relation(fields: [relatedClientId], references: [id])
  relatedBooking Booking? @relation(fields: [relatedBookingId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@index([relatedClientId])
  @@index([relatedBookingId])
  @@index([dueAt])
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseSkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  CONFIRMED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum CoursePaymentStanding {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  OVERDUE
}

enum ClassProgressStatus {
  NOT_SCHEDULED
  SCHEDULED
  STARTED
  FINISHED
  POSTPONED
  CANCELLED
}

enum RegistrationSource {
  WEBSITE
  ADMIN
  RECEPTION
}

enum CoursePaymentMethod {
  CASH
  BANK_TRANSFER
}

enum CourseLedgerType {
  PAYMENT
  REFUND
  REVERSAL
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TestimonialKind {
  CLIENT
  STUDENT
}

enum GalleryKind {
  STUDIO
  TRAINING
  RESULT
}

model ServiceContent {
  id                String            @id @default(uuid())
  serviceId         String?           @unique
  slug              String            @unique
  code              String?
  headline          String
  category          String
  summary           String
  longDescription   String            @db.Text
  benefits          String            @db.Text
  preparation       String            @db.Text
  aftercare         String            @db.Text
  faqs              Json
  featured          Boolean           @default(false)
  displayOrder      Int               @default(0)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model Course {
  id                 String            @id
  code               String            @unique
  name               String
  slug               String            @unique
  category           String
  shortDescription   String
  fullDescription    String            @db.Text
  skillLevel         CourseSkillLevel
  prerequisites      String?           @db.Text
  learningObjectives String?           @db.Text
  durationLabel      String
  durationPublished  Boolean           @default(false)
  trainingDays       String?
  fee                Decimal?          @db.Decimal(12, 2)
  feePublished       Boolean           @default(false)
  deposit            Decimal?          @db.Decimal(12, 2)
  includedMaterials  String?           @db.Text
  safetyNotes        String?           @db.Text
  toolsAndMaterials  String?           @db.Text
  additionalNotes    String?           @db.Text
  registrationInfo   String?           @db.Text
  faqs               Json?
  registrationOpen   Boolean           @default(true)
  featured           Boolean           @default(false)
  publicationStatus  PublicationStatus @default(DRAFT)
  displayOrder       Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  modules       CourseModule[]
  registrations CourseRegistration[]

  @@index([publicationStatus, displayOrder])
  @@index([category])
}

model CourseModule {
  id           String   @id @default(uuid())
  courseId     String
  kind         String
  title        String
  summary      String?
  displayOrder Int
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics       CourseTopic[]

  @@index([courseId, displayOrder])
}

model CourseTopic {
  id           String       @id @default(uuid())
  moduleId     String
  title        String
  description  String?      @db.Text
  displayOrder Int
  module       CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, displayOrder])
}

model Student {
  id          String   @id @default(uuid())
  fullName    String
  phone       String   @unique
  email       String?
  city        String?
  experience  String?  @db.Text
  note        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations CourseRegistration[]
  payments      CoursePayment[]

  @@index([fullName])
}

model RegistrationCounter {
  year Int @id
  last Int @default(0)
}

model CourseRegistration {
  id                   String                @id @default(uuid())
  registrationNumber   String                @unique
  studentId            String
  courseId             String
  intakeName           String?
  intakeKey            String                @default("")
  expectedStartDate    DateTime?
  actualStartedAt      DateTime?
  actualFinishedAt     DateTime?
  registrationStatus   RegistrationStatus    @default(PENDING)
  paymentStanding      CoursePaymentStanding @default(UNPAID)
  classProgress        ClassProgressStatus   @default(NOT_SCHEDULED)
  source               RegistrationSource    @default(WEBSITE)
  agreedFee            Decimal?              @db.Decimal(12, 2)
  approvedDiscount     Decimal               @default(0) @db.Decimal(12, 2)
  requiredDeposit      Decimal?              @db.Decimal(12, 2)
  submittedName        String
  addressSnapshot      String?
  experienceSnapshot   String?               @db.Text
  notes                String?               @db.Text
  consentAcceptedAt    DateTime
  activeKey            String                @default("open")
  idempotencyKey       String?               @unique
  accessTokenHash      String
  registeredAt         DateTime              @default(now())
  approvedAt           DateTime?
  confirmedAt          DateTime?
  createdById          String?
  updatedById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  student   Student         @relation(fields: [studentId], references: [id])
  course    Course          @relation(fields: [courseId], references: [id])
  createdBy User?           @relation("RegistrationCreatedBy", fields: [createdById], references: [id])
  updatedBy User?           @relation("RegistrationUpdatedBy", fields: [updatedById], references: [id])
  payments  CoursePayment[]
  events    RegistrationEvent[]

  @@unique([studentId, courseId, intakeKey, activeKey])
  @@index([registrationStatus])
  @@index([paymentStanding])
  @@index([classProgress])
  @@index([registeredAt])
  @@index([courseId])
  @@index([intakeKey])
  @@index([source])
}

model CoursePayment {
  id                    String                    @id @default(uuid())
  registrationId        String
  studentId             String
  amount                Decimal                   @db.Decimal(12, 2)
  method                CoursePaymentMethod
  ledgerType            CourseLedgerType          @default(PAYMENT)
  paidAt                DateTime
  transactionReference  String?
  referenceGuard        String?                   @unique
  proofPath             String?
  verificationStatus    PaymentVerificationStatus @default(PENDING)
  idempotencyKey        String?                   @unique
  recordedById          String?
  verifiedById          String?
  verifiedAt            DateTime?
  remarks               String?
  reversesPaymentId     String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  registration CourseRegistration @relation(fields: [registrationId], references: [id])
  student      Student            @relation(fields: [studentId], references: [id])
  recordedBy   User?              @relation("CoursePaymentRecordedBy", fields: [recordedById], references: [id])
  verifiedBy   User?              @relation("CoursePaymentVerifiedBy", fields: [verifiedById], references: [id])

  @@index([registrationId])
  @@index([studentId])
  @@index([verificationStatus])
  @@index([reversesPaymentId])
  @@index([transactionReference])
}

model RegistrationEvent {
  id             String             @id @default(uuid())
  registrationId String
  action         String
  previousValue  String?
  newValue       String?
  reason         String?
  actorId        String?
  createdAt      DateTime           @default(now())

  registration CourseRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor        User?              @relation(fields: [actorId], references: [id])

  @@index([registrationId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

model SiteSetting {
  id             String   @id @default("primary")
  heroTitle      String
  heroText       String   @db.Text
  aboutTitle     String
  aboutText      String   @db.Text
  contactEmail   String?
  emailVerified  Boolean  @default(false)
  addressLine    String
  city           String
  phonePrimary   String
  phoneSecondary String
  hoursNote      String?
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?
  mapUrl         String?
  footerText     String?
  updatedAt      DateTime @updatedAt
}

model Testimonial {
  id                String            @id @default(uuid())
  kind              TestimonialKind
  quote             String            @db.Text
  authorName        String
  roleLabel         String?
  consentNote       String?
  publicationStatus PublicationStatus @default(DRAFT)
  displayOrder      Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([publicationStatus, displayOrder])
}

model GalleryAsset {
  id                String            @id @default(uuid())
  title             String
  caption           String?
  altText           String
  kind              GalleryKind
  consentRecorded   Boolean           @default(false)
  consentNote       String?
  publicationStatus PublicationStatus @default(DRAFT)
  displayOrder      Int               @default(0)
  beforeType        String?
  beforeSize        Int?
  beforeData        Bytes?
  afterType         String?
  afterSize         Int?
  afterData         Bytes?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([publicationStatus, displayOrder])
  @@index([kind])
}

model WebsiteFaq {
  id                String            @id @default(uuid())
  scope             String
  question          String
  answer            String            @db.Text
  displayOrder      Int               @default(0)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([scope, publicationStatus, displayOrder])
}
