generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECEPTIONIST
}

enum BookingSource {
  ONLINE_CLIENT
  ADMIN
  RECEPTIONIST
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_UPLOADED
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum PaymentStatus {
  NOT_PAID
  PROOF_UPLOADED
  ADVANCE_CONFIRMED
  FULLY_PAID
  PAYMENT_REJECTED
}

enum NotificationChannel {
  TELEGRAM
  SMS
  EMAIL
  WHATSAPP
}

enum StaffTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum StaffTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PermissionKey {
  VIEW_DASHBOARD
  VIEW_CALENDAR
  MANAGE_CALENDAR
  VIEW_BOOKINGS
  CREATE_BOOKINGS
  MANAGE_BOOKINGS
  CONFIRM_PAYMENTS
  VIEW_CLIENTS
  MANAGE_CLIENTS
  VIEW_PAYMENTS
  MANAGE_TASKS
  MANAGE_SERVICES
  MANAGE_BANK_ACCOUNTS
  MANAGE_AVAILABILITY
  MANAGE_STAFF
  MANAGE_ROLES
  MANAGE_NOTIFICATIONS
  VIEW_REPORTS
}

enum TelegramNotificationEvent {
  PAYMENT_PROOF_UPLOADED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  BOOKING_RESCHEDULED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  BOOKING_NO_SHOW
}

enum BookingSubmissionStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  name         String
  phone        String?
  email        String?   @unique
  username     String    @unique
  passwordHash String
  role         UserRole
  staffRoleId  String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBookings             Booking[]            @relation("BookedBy")
  confirmedBookings           Booking[]            @relation("ConfirmedBy")
  cancelledBookings           Booking[]            @relation("CancelledBy")
  verifiedPayments            Payment[]            @relation("PaymentVerifiedBy")
  forfeitedPayments           Payment[]            @relation("PaymentAdvanceForfeitedBy")
  uploadedPrecautionDocuments PrecautionDocument[] @relation("PrecautionDocumentUploadedBy")
  bookingLogs                 BookingStatusLog[]
  assignedTasks               StaffTask[]          @relation("TaskAssignedTo")
  createdTasks                StaffTask[]          @relation("TaskCreatedBy")
  staffRole                   StaffRole?           @relation(fields: [staffRoleId], references: [id])

  @@index([staffRoleId])
  @@index([deletedAt])
}

model StaffRole {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  isSystem    Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@index([deletedAt])
}

model RolePermission {
  id          String        @id @default(uuid())
  staffRoleId String
  permission  PermissionKey
  staffRole   StaffRole     @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)

  @@unique([staffRoleId, permission])
  @@index([permission])
}

model Client {
  id             String    @id @default(uuid())
  fullName       String
  phone          String
  alternatePhone String?
  email          String?
  address        String?
  birthDate      DateTime?
  source         String?
  preferences    String?
  allergies      String?
  note           String?
  internalNote   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bookings Booking[]
  tasks    StaffTask[]

  @@index([phone])
  @@index([isActive])
}

model Service {
  id                         String    @id @default(uuid())
  name                       String
  category                   String?
  description                String?
  price                      Decimal   @db.Decimal(12, 2)
  advanceAmount              Decimal   @db.Decimal(12, 2)
  durationMinutes            Int
  bufferMinutes              Int       @default(0)
  bookingWarningTitle        String?
  bookingWarningIntro        String?
  bookingWarningInstructions String?
  bookingWarningContact      String?
  bookingWarningActive       Boolean   @default(false)
  isActive                   Boolean   @default(true)
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  bookings Booking[]
  image    ServiceImage?

  @@index([deletedAt])
}

model ServiceImage {
  id          String   @id @default(uuid())
  serviceId   String   @unique
  fileName    String
  contentType String
  fileSize    Int
  fileData    Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model BookingSetting {
  id                  String   @id @default("primary")
  slotIntervalMinutes Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WorkingHour {
  id          String   @id @default(uuid())
  dayOfWeek   Int
  openingTime String
  closingTime String
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dayOfWeek])
}

model BreakTime {
  id        String   @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DayOff {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  startTime String?
  endTime   String?
  isFullDay Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model BankAccount {
  id            String    @id @default(uuid())
  bankName      String
  accountName   String
  accountNumber String
  instructions  String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments Payment[]

  @@index([deletedAt])
}

model Booking {
  id                        String        @id @default(uuid())
  bookingCode               String        @unique
  clientId                  String
  serviceId                 String
  startDateTime             DateTime
  endDateTime               DateTime
  status                    BookingStatus @default(PENDING_PAYMENT)
  source                    BookingSource
  bookedByUserId            String?
  confirmedByUserId         String?
  cancelledByUserId         String?
  note                      String?
  expiresAt                 DateTime?
  precautionsAcknowledgedAt DateTime?
  precautionNoticeSnapshot  String?
  precautionDocumentId      String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  client             Client              @relation(fields: [clientId], references: [id])
  service            Service             @relation(fields: [serviceId], references: [id])
  bookedBy           User?               @relation("BookedBy", fields: [bookedByUserId], references: [id])
  confirmedBy        User?               @relation("ConfirmedBy", fields: [confirmedByUserId], references: [id])
  cancelledBy        User?               @relation("CancelledBy", fields: [cancelledByUserId], references: [id])
  precautionDocument PrecautionDocument? @relation(fields: [precautionDocumentId], references: [id])

  payment          Payment?
  statusLogs       BookingStatusLog[]
  notificationLogs NotificationLog[]
  tasks            StaffTask[]
  submission       BookingSubmission?

  @@index([startDateTime])
  @@index([endDateTime])
  @@index([status])
  @@index([source])
  @@index([bookedByUserId])
  @@index([precautionDocumentId])
}

model BookingSubmission {
  id                 String                  @id @default(uuid())
  tokenHash          String                  @unique
  phoneHash          String
  requestFingerprint String
  status             BookingSubmissionStatus @default(PROCESSING)
  bookingId          String?                 @unique
  attemptCount       Int                     @default(1)
  lastErrorCode      String?
  lastAttemptedAt    DateTime                @default(now())
  completedAt        DateTime?
  expiresAt          DateTime
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([phoneHash])
  @@index([status, expiresAt])
}

model SecuritySetting {
  id                   String   @id @default("primary")
  loginMax             Int      @default(5)
  loginWindowSeconds   Int      @default(900)
  bookingIpMax         Int      @default(5)
  bookingPhoneMax      Int      @default(3)
  bookingWindowSeconds Int      @default(900)
  statusMax            Int      @default(10)
  statusWindowSeconds  Int      @default(600)
  slotsMax             Int      @default(120)
  slotsWindowSeconds   Int      @default(300)
  uploadMax            Int      @default(5)
  uploadWindowSeconds  Int      @default(900)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RateLimitBucket {
  id          String   @id @default(uuid())
  action      String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([action, keyHash, windowStart])
  @@index([expiresAt])
}

model PrecautionDocument {
  id               String    @id @default(uuid())
  title            String
  fileName         String
  contentType      String
  fileSize         Int
  fileData         Bytes
  isActive         Boolean   @default(false)
  uploadedByUserId String?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())

  uploadedBy User?     @relation("PrecautionDocumentUploadedBy", fields: [uploadedByUserId], references: [id])
  bookings   Booking[]

  @@index([isActive])
  @@index([createdAt])
  @@index([uploadedByUserId])
}

model Payment {
  id                       String        @id @default(uuid())
  bookingId                String        @unique
  requiredAdvanceAmount    Decimal       @db.Decimal(12, 2)
  paidAmount               Decimal?      @db.Decimal(12, 2)
  paymentStatus            PaymentStatus @default(NOT_PAID)
  paymentMethod            String?
  bankAccountId            String?
  screenshotPath           String?
  verifiedByUserId         String?
  verifiedAt               DateTime?
  rejectionReason          String?
  advanceForfeitedAmount   Decimal?      @db.Decimal(12, 2)
  advanceForfeitedAt       DateTime?
  advanceForfeitedByUserId String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  booking            Booking      @relation(fields: [bookingId], references: [id])
  bankAccount        BankAccount? @relation(fields: [bankAccountId], references: [id])
  verifiedBy         User?        @relation("PaymentVerifiedBy", fields: [verifiedByUserId], references: [id])
  advanceForfeitedBy User?        @relation("PaymentAdvanceForfeitedBy", fields: [advanceForfeitedByUserId], references: [id])

  @@index([advanceForfeitedByUserId])
}

model BookingStatusLog {
  id              String         @id @default(uuid())
  bookingId       String
  oldStatus       BookingStatus?
  newStatus       BookingStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime       @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id])
  changedBy User?   @relation(fields: [changedByUserId], references: [id])
}

model NotificationLog {
  id           String              @id @default(uuid())
  bookingId    String?
  channel      NotificationChannel
  recipient    String
  message      String
  status       String
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])
}

model TelegramBotSetting {
  id                String   @id @default("primary")
  botTokenEncrypted String
  botUsername       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TelegramRecipient {
  id            String                 @id @default(uuid())
  name          String
  chatId        String                 @unique
  personalId    String?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  subscriptions TelegramSubscription[]

  @@index([isActive])
}

model TelegramSubscription {
  id          String                    @id @default(uuid())
  recipientId String
  event       TelegramNotificationEvent
  recipient   TelegramRecipient         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, event])
  @@index([event])
}

model SmsSetting {
  id                       String   @id @default("primary")
  apiTokenEncrypted        String
  identifierId             String
  senderName               String
  isActive                 Boolean  @default(true)
  notifyPaymentConfirmed   Boolean  @default(true)
  notifyPaymentRejected    Boolean  @default(true)
  notifyBookingRescheduled Boolean  @default(true)
  notifyBookingCancelled   Boolean  @default(true)
  notifyBookingCompleted   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model StaffTask {
  id               String            @id @default(uuid())
  title            String
  description      String?
  status           StaffTaskStatus   @default(TODO)
  priority         StaffTaskPriority @default(NORMAL)
  assignedToUserId String?
  createdByUserId  String?
  relatedClientId  String?
  relatedBookingId String?
  dueAt            DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  assignedTo     User?    @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy      User?    @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  relatedClient  Client?  @relation(fields: [relatedClientId], references: [id])
  relatedBooking Booking? @relation(fields: [relatedBookingId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@index([relatedClientId])
  @@index([relatedBookingId])
  @@index([dueAt])
}
