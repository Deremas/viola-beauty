DATABASE_URL="postgresql://username:password@localhost:5432/viola_booking"
# Integration tests must use a separate disposable database.
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/viola_booking_test"
# Optional extra guard used by integration tests.
PRODUCTION_DATABASE_URL=""
AUTH_SECRET="replace_with_secure_secret"
NEXTAUTH_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
TELEGRAM_BOT_TOKEN="123456789:YOUR_BOT_TOKEN"
TELEGRAM_ADMIN_CHAT_ID="123456789"
APP_TIMEZONE="Africa/Addis_Ababa"
UPLOAD_DIR="./storage/uploads"
# Optional locally: set to "database" to test the same storage used on Vercel.
PAYMENT_PROOF_STORAGE="local"

# Vercel automatically stores payment proofs in the database for persistent demo uploads.
